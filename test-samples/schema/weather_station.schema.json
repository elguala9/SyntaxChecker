{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["station", "readings"],
  "properties": {
    "station": {
      "type": "object",
      "required": ["id", "altitude_m"],
      "properties": {
        "id":         { "type": "string", "pattern": "^WS-[0-9]{3}$" },
        "altitude_m": { "type": "integer", "minimum": -500, "maximum": 9000 }
      }
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["temp_c", "humidity"],
        "properties": {
          "temp_c":   { "type": "number", "minimum": -90, "maximum": 60 },
          "humidity": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
