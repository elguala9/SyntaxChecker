{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status"],
  "oneOf": [
    {
      "properties": {
        "status": { "const": "ok" },
        "data":   { "type": "object" }
      },
      "required": ["data"]
    },
    {
      "properties": {
        "status":  { "const": "error" },
        "code":    { "type": "integer", "minimum": 400, "maximum": 599 },
        "message": { "type": "string" }
      },
      "required": ["code", "message"]
    }
  ]
}
